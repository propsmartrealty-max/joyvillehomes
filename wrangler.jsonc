{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joyville-homes",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "build": {
    "command": "npm run cf:build"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://joyville-homes.com",
    "ENVIRONMENT": "production"
  }
}
